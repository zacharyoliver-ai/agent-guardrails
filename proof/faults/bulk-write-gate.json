    {
      "fault": "SQL files handed to a client with -f or < are never read, so their statements pass.",
      "file": "hooks/bulk-write-gate.mjs",
      "find": "if (text !== null) texts.push([text, false]);",
      "replace": "if (false) texts.push([text, false]);",
      "test": "node --test test/bulk-write-gate.test.mjs"
