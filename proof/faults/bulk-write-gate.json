{
  "name": "bulk-write-gate",
  "kind": "guard",
  "what": "A SQL write that would change every row of a table is refused unless the statement carries a bulk-ok comment with a reason.",
  "faults": [
    {
      "fault": "A heredoc piped into a client is skipped, so cat <<EOF | psql walks past the gate.",
      "file": "hooks/bulk-write-gate.mjs",
      "find": "!CLIENT_WORD.test(owner) && !PIPED_INTO_CLIENT.test(pipedOn)",
      "replace": "!CLIENT_WORD.test(owner)",
      "test": "node --test test/bulk-write-gate.test.mjs"
    },
    {
      "fault": "Every heredoc on a line with a client counts as SQL, so a note written to a file is refused.",
      "file": "hooks/bulk-write-gate.mjs",
      "find": "!CLIENT_WORD.test(owner) && !PIPED_INTO_CLIENT.test(pipedOn)",
      "replace": "false",
      "test": "node --test test/bulk-write-gate.test.mjs"
    },
    {
      "fault": "A WHERE clause that is always true, such as 1=1, is accepted as a real filter.",
      "file": "hooks/bulk-write-gate.mjs",
      "find": "if (cond === null || alwaysTrue(cond))",
      "replace": "if (cond === null)",
      "test": "node --test test/bulk-write-gate.test.mjs"
    },
    {
      "fault": "The bulk-ok comment is ignored, so an approved statement is still refused.",
      "file": "hooks/bulk-write-gate.mjs",
      "find": "if (ok[i]) continue;",
      "replace": "if (false) continue;",
      "test": "node --test test/bulk-write-gate.test.mjs"
    },
    {
      "fault": "Protected tables are never matched, so their updates and deletes pass.",
      "file": "hooks/bulk-write-gate.mjs",
      "find": "const guarded = protectedTables.has(lastPart(table));",
      "replace": "const guarded = false;",
      "test": "node --test test/bulk-write-gate.test.mjs"
    },
    {
      "fault": "git commands are no longer exempt, so a commit message that mentions SQL is refused.",
      "file": "hooks/bulk-write-gate.mjs",
      "find": "new Set(['git', 'gh', 'echo'",
      "replace": "new Set(['gh', 'echo'",
      "test": "node --test test/bulk-write-gate.test.mjs"
    },
    {
      "fault": "TRUNCATE is no longer recognised as a bulk write.",
      "file": "hooks/bulk-write-gate.mjs",
      "find": "if (verb === 'truncate')",
      "replace": "if (verb === 'truncatee')",
      "test": "node --test test/bulk-write-gate.test.mjs"
    },
    {
      "fault": "The PowerShell tool is no longer read, so a delete through Invoke-Sqlcmd passes.",
      "file": "hooks/bulk-write-gate.mjs",
      "find": "if (input.tool_name === 'Bash' || input.tool_name === 'PowerShell') {",
      "replace": "if (input.tool_name === 'Bash') {",
      "test": "node --test test/bulk-write-gate.test.mjs"
    },
    {
      "fault": "curl is no longer exempt, so a request body that mentions SQL is refused.",
      "file": "hooks/bulk-write-gate.mjs",
      "find": "'find', 'curl', 'wget']",
      "replace": "'find']",
      "test": "node --test test/bulk-write-gate.test.mjs"
    },
    {
