{
  "name": "planted-fault",
  "kind": "proof-tool",
  "what": "A planted bug is reported CAUGHT only when the named test fails on it, and the file is always put back exactly as it was.",
  "faults": [
    {
      "fault": "A test that still passes with the bug in place is reported as CAUGHT.",
      "file": "bin/planted-fault.mjs",
      "find": "return second.status === 0",
      "replace": "return second.status !== 0",
      "test": "node --test test/planted-fault.test.mjs"
    },
    {
      "fault": "A test that is already red before the bug is planted is still accepted.",
      "file": "bin/planted-fault.mjs",
      "find": "if (first.status !== 0) {",
      "replace": "if (false) {",
      "test": "node --test test/planted-fault.test.mjs"
    },
    {
      "fault": "A find text that matches more than once is accepted.",
      "file": "bin/planted-fault.mjs",
      "find": "if (parts.length !== 2) {",
      "replace": "if (parts.length < 2) {",
      "test": "node --test test/planted-fault.test.mjs"
    },
    {
      "fault": "The file is left broken after the run.",
      "file": "bin/planted-fault.mjs",
      "find": "const restore = () => fs.writeFileSync(file, original);",
      "replace": "const restore = () => {};",
      "test": "node --test test/planted-fault.test.mjs"
    },
    {
      "fault": "The test run has no time limit, so a fault that hangs the test hangs the tool.",
      "file": "bin/planted-fault.mjs",
      "find": "encoding: 'utf8', timeout: timeoutS * 1000 }",
      "replace": "encoding: 'utf8' }",
      "test": "node --test test/planted-fault.test.mjs"
    },
    {
      "fault": "A run killed by a signal is reported as CAUGHT.",
      "file": "bin/planted-fault.mjs",
      "find": "const cutShort = (r) => r.status === null || Boolean(r.error);",
      "replace": "const cutShort = () => false;",
      "test": "node --test test/planted-fault.test.mjs"
    },
    {
      "fault": "The clean run gets the small limit too, so a slow machine reads as a setup problem.",
      "file": "bin/planted-fault.mjs",
      "find": "const firstLimit = Math.max(timeout, DEFAULT_TIMEOUT_S);",
      "replace": "const firstLimit = timeout;",
      "test": "node --test test/planted-fault.test.mjs"
    }
  ]
}
